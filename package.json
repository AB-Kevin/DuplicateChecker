{
  "name": "duplicate-checker",
  "productName": "Duplicate Checker",
  "version": "1.1.0",
  "description": "Watches an inbox folder for spreadsheets, flags likely duplicate rows for review, and maintains a rolling database and a duplicates log.",
  "author": "Anabaptist Brotherhood",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "preversion": "npm test",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "ab-common": "git+https://github.com/AB-Kevin/ab-common.git#v1.1.0",
    "chokidar": "^4.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "org.anabaptistbrotherhood.duplicatechecker",
    "productName": "Duplicate Checker",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "DuplicateChecker",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DuplicateChecker-Setup-${version}.${ext}"
    }
  }
}
